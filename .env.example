####################################
## LIMIT MANAGE UTILS FOR MISSKEY ##
####################################
# Every value can also be given as an environment variable of the same name.
# Environment variables take precedence over this file.

## BASIC ##
# Misskey server origin (without /api)
LM_ORIGIN=https://misskey.io
# Old name, still accepted with a warning: the trailing /api is removed automatically
# LM_BASE_URL=https://misskey.io/api

# Misskey API Token
# see: https://misskey-hub.net/en/docs/api/#manually-issue-an-access-token
LM_API_TOKEN=YOU_MUST_SET_YOUR_API_TOKEN


## INTERVALS (seconds) ##
# Wait after every successful API call
LM_POLL_BASE=3
# Wait before retrying after a 5xx response or a network error
LM_POLL_NETERROR=300
# Give up a request after this many consecutive 5xx / network errors
LM_NETERROR_MAX_RETRIES=5

# Fallback back-off on 429 without retry information: starts at BASE, doubles, capped at MAX
LM_POLL_RATELIMIT_BASE=600
LM_POLL_RATELIMIT_MAX=43200


## LOGGING ##
# debug, info, warn, error (Python-style INFO / WARNING / CRITICAL are accepted too)
LM_LOGLEVEL=info
# Also write the log to LM_LOGFILENAME (the console always gets it)
LM_LOGFILE=False
LM_LOGFILENAME=limitmanage.log
# IANA time zone for log timestamps
LM_LOG_TIMEZONE=Asia/Tokyo


## DAYS EXPIRE MODE ##
# Delete rule set (see README)
LM_DELETERULE=deleterule.json
# If set to 'true' print all your notes as JSON to stdout for backups (same as --print-notes)
LM_DELETE_STEP2PRINT=False


## REMOVED (ignored with a warning) ##
# LM_DEBUGLEVEL=0
# LM_USERAGENT='Mozilla/5.0 ...'
